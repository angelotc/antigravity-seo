{
  "seo-schema-lint": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|Write|Edit|MultiEdit|write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/schema_linter.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
